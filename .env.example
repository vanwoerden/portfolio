# PostHog (client-exposed — VITE_ prefix means Vite inlines this into the client bundle)
VITE_POSTHOG_KEY=changeme
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Access-link signing secret (server-side only — do NOT prefix with VITE_, or it
# will end up in the client bundle). Generate with: openssl rand -hex 32
# Set the SAME value in the Netlify dashboard: Site settings > Environment variables
ACCESS_TOKEN_SECRET=changeme-generate-a-long-random-string

# Base URL used locally by scripts/generate-link.js to print the full activation link
SITE_URL=https://ernst.works

# Family area (ernst.works/family). Server-side only; set the SAME values in the Netlify
# dashboard (Site configuration > Environment variables). Generate each with: openssl rand -hex 32
# FAMILY_TOKEN_SECRET signs the shared family link and session cookies; changing it revokes everyone.
FAMILY_TOKEN_SECRET=changeme-generate-a-long-random-string
# FAMILY_INGEST_SECRET lets the Mac agent in family/ upload the rendered pages (never committed to git).
FAMILY_INGEST_SECRET=changeme-generate-a-different-long-random-string
# Optional: fallback timezone for "today" when Netlify cannot tell the viewer's (default America/New_York).
# FAMILY_TZ=America/New_York
